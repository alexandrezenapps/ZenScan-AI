rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Search Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.get('uid', request.auth.uid) == request.auth.uid
        && (data.get('email', '') == null || data.get('email', '') is string)
        && (data.get('displayName', '') == null || data.get('displayName', '') is string)
        && (data.get('photoURL', '') == null || data.get('photoURL', '') is string);
    }

    function isValidDocument(data) {
      return data.userId == request.auth.uid
        && data.id is string
        && data.name is string
        && data.type in ['PDF', 'JPG', 'PNG', 'JPEG']
        && data.tags is list
        && data.isAiEnhanced is bool
        && (data.get('ocrLanguage', '') == null || data.get('ocrLanguage', '') is string)
        && (data.get('thumbnailUrl', '') == null || data.get('thumbnailUrl', '') is string);
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isOwner(userId)
        && (
          // Admin override
          false || 
          // Action: Profile Update
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) &&
            incoming().get('updatedAt', request.time) == request.time
          )
        );

      match /documents/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidId(docId)
          && isValidDocument(incoming())
          && (incoming().id == docId || incoming().id == null)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
          
        allow update: if isOwner(userId)
          && isValidId(docId)
          && isValidDocument(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'category', 'tags', 'isAiEnhanced', 'contentSnippet', 'extractedData', 'ocrLanguage', 'thumbnailUrl', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(docId);
      }
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
