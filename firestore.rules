rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid']) &&
             data.uid == request.auth.uid &&
             (data.get('email', null) == null || data.email is string) &&
             (data.get('displayName', null) == null || data.displayName is string) &&
             (data.get('cloudSyncEnabled', true) is bool) &&
             (data.get('updatedAt', request.time) is timestamp || data.get('lastActive', request.time) is timestamp);
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['id', 'name', 'type']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.type in ['PDF', 'JPG', 'PNG'] &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('userId' in data) || (data.userId == request.auth.uid)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // --- Collection Matches ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && 
                      isValidUserProfile(incoming()) &&
                      incoming().uid == existing().uid &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'email', 'displayName', 'cloudSyncEnabled', 'lastActive', 'updatedAt']);
      
      match /documents/{documentId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(documentId) && isValidDocument(incoming());
        allow update: if isOwner(userId) && 
                        isValidDocument(incoming()) &&
                        incoming().id == existing().id &&
                        incoming().diff(existing()).affectedKeys().hasAny(['name', 'category', 'tags', 'isAiEnhanced', 'extractedData', 'url', 'thumbnailUrl', 'ocrLanguage', 'location', 'updatedAt', 'modifiedAt']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
