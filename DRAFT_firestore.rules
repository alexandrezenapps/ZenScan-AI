rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Search Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().size() == 6
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 128
        && data.photoURL is string && data.photoURL.size() <= 512
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type', 'category', 'size', 'modifiedAt', 'tags', 'isAiEnhanced', 'contentSnippet', 'extractedData', 'createdAt', 'updatedAt'])
        && data.keys().size() == 13
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.type in ['PDF', 'JPG', 'PNG']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        );

      match /documents/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidId(docId)
          && isValidDocument(incoming())
          && (incoming().id == docId || incoming().id == null)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
          
        allow update: if isOwner(userId)
          && isValidId(docId)
          && isValidDocument(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'category', 'tags', 'isAiEnhanced', 'contentSnippet', 'extractedData', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(docId);
      }
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
